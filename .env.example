# Supabase Project Settings > APIで確認する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。Vercelでは Production / Preview のServer Environment Variableに設定する。
# NEXT_PUBLIC_ を付けないこと。ブラウザやGitへ公開しないこと。
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Verification only: use a Resend-verified sender. Never set this to a real-store address.
RESEND_FROM_EMAIL=
# Must remain false in every deployed environment. A local test may explicitly set true.
STORE_AUTH_EMAIL_DRY_RUN=false

# 管理者の招待・パスワード再設定メールで使用する、本人向けパスワード設定画面。
# PreviewはVerification固定URL、Productionは本番URLをそれぞれ設定する。
ADMIN_AUTH_REDIRECT_URL=

# 初回だけ scripts/bootstrap-auth-users.mjs を実行する場合のサーバー専用値。
# 実行後はこの4項目を削除するか、ローカル環境にだけ保管する。
BOOTSTRAP_ADMIN_EMAIL=k.nishida@vexum-ai.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STORE_CODE=TEST-01
BOOTSTRAP_STORE_PASSWORD=
BOOTSTRAP_STORE_NAME=テスト店舗
BOOTSTRAP_STORE_AREA=テスト

# 試作モード（検証環境限定）。trueの場合だけログイン欄を初期入力する。
# NEXT_PUBLIC_* はブラウザへ配信されるため、本番の認証情報は設定しない。
NEXT_PUBLIC_PROTOTYPE_MODE=false
NEXT_PUBLIC_PROTOTYPE_STORE_CODE=
NEXT_PUBLIC_PROTOTYPE_STORE_PIN=
