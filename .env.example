# ==============================================================================
# INSOU メニュー閲覧システム - 環境変数テンプレート
# ==============================================================================
# 【重要・接続方針】
# ローカル開発（.env.local）では、必ず【Verification環境】（cqlddcxvanwoxpaouzow）
# またはローカルSupabaseの接続情報を設定してください。
# 誤操作による本番データ破壊・汚染を防ぐため、本番環境（Production: yzvencvfkltxehcjpgol）の
# 接続情報をローカルの .env.local に設定することは固く禁止されています。
# ==============================================================================

# Supabase 設定（Verification: cqlddcxvanwoxpaouzow の値を設定）
NEXT_PUBLIC_SUPABASE_URL=https://cqlddcxvanwoxpaouzow.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用キー（ブラウザやGitへ絶対に公開しないこと）
SUPABASE_SECRET_KEY=
OTP_HMAC_SECRET=

# メール送信設定（Verification用）
RESEND_API_KEY=
# Verification only: use a Resend-verified sender. Never set this to a real-store address.
RESEND_FROM_EMAIL=
# Must remain false in every deployed environment. A local test may explicitly set true.
STORE_AUTH_EMAIL_DRY_RUN=false

# 管理者の招待・パスワード再設定メールで使用するリダイレクト先URL
# ローカル開発時は http://localhost:3000、PreviewはVerification固定URL
ADMIN_AUTH_REDIRECT_URL=http://localhost:3000/admin/setup-password

# 初回セットアップ用（必要な場合のみローカルで一時利用）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STORE_CODE=
BOOTSTRAP_STORE_PASSWORD=
BOOTSTRAP_STORE_NAME=
BOOTSTRAP_STORE_AREA=

